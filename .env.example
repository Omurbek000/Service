SECRET_KEY=your-secret-key-here

# PostgreSQL
POSTGRES_DB=autodub
POSTGRES_USER=autodub
POSTGRES_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3 storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-minio-password

# FFmpeg (path to ffmpeg.exe or just ffmpeg if in PATH)
FFMPEG_PATH=ffmpeg

# Whisper
WHISPER_MODEL=base
MOCK_ML=false

# Translation
TRANSLATE_PROVIDER=mock
# GOOGLE_API_KEY=

# NLLB (local model)
NLLB_MODEL=facebook/nllb-200-distilled-600M

# Diarization
# HF_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# CosyVoice GPU-воркер (ТЗ Дни 17-19) — вставь URL туннеля Colab/Kaggle
# COSYVOICE_URL=https://xxx.trycloudflare.com
# COSYVOICE_ENABLED=true
# COSYVOICE_TIMEOUT=30
# COSYVOICE_HEALTH_TIMEOUT=5
# COSYVOICE_SAMPLE_MIN_DURATION=1.5
