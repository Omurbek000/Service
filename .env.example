SECRET_KEY=вставь-сюда-свой-секретный-ключ

# PostgreSQL
POSTGRES_DB=autodub
POSTGRES_USER=autodub
POSTGRES_PASSWORD=пароль-базы
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-хранилище)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=пароль-minio

# FFmpeg (path to ffmpeg.exe or just ffmpeg if in PATH)
FFMPEG_PATH=ffmpeg

# Whisper
WHISPER_MODEL=base
MOCK_ML=false

# Translation
TRANSLATE_PROVIDER=mock
# GOOGLE_API_KEY=
